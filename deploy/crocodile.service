[Unit]
Description=Crocodile drawing game API
After=network.target

[Service]
Type=simple
DynamicUser=true
StateDirectory=crocodile
StateDirectoryMode=0700
WorkingDirectory=/var/lib/crocodile
ExecStart=/opt/crocodile/current/crocodile -addr 127.0.0.1:8091 -db /var/lib/crocodile/game.db
Environment=GOMAXPROCS=1
Environment=GOMEMLIMIT=64MiB
Restart=on-failure
RestartSec=3
MemoryMax=128M
CPUQuota=25%
TasksMax=64
LimitNOFILE=1024
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
